      url "https://github.com/Bel-Consulting-OU/kiwi-ci/releases/download/v__VERSION__/kiwi-darwin-amd64"
      sha256 "__SHA_DARWIN_AMD64__"
    end
  end

  def install
    bin.install Dir["kiwi-darwin-*"].first => "kiwi"
  end

  test do
    assert_match "kiwi", shell_output("#{bin}/kiwi version")
  end
end
